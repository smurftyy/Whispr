# Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Core ---
NODE_ENV=development
PORT=3000

# --- MongoDB ---
MONGODB_URI=

# --- Redis (Bull Queue) ---
# Use redis:// for local, rediss:// for managed TLS providers (Upstash, Render Redis, etc.)
REDIS_URL=redis://localhost:6379

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
MINI_APP_URL=

# --- AI Provider ---
# 'chrono' (default, no key needed) or 'claude'
AI_PROVIDER=chrono
# Required only when AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: force server timezone (recommended: UTC)
# TZ=UTC

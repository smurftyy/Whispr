# Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Core ---
NODE_ENV=development
PORT=3000

# --- MongoDB ---
MONGODB_URI=

# --- Redis (Bull Queue) ---
# Use redis:// for local, rediss:// for managed TLS providers (Upstash, Render Redis, etc.)
REDIS_URL=redis://localhost:6379

# --- Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
MINI_APP_URL=

# AI Provider — set to 'claude' and add CLAUDE_API_KEY to switch NLP provider
AI_PROVIDER=gemini
CLAUDE_API_KEY=
